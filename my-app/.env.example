# Variables d'environnement pour DataAnalyzer

# ===== OBLIGATOIRE =====
# Votre clé API OpenAI (obtenez-la sur https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# ===== OPTIONNEL =====
# Model OpenAI à utiliser (par défaut: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Environnement (development, production)
# NODE_ENV=development

# Port du serveur (par défaut: 3000)
# PORT=3000

# Base URL pour les requêtes API (pour production)
# NEXT_PUBLIC_API_URL=https://your-domain.com

# ===== SENTRY (Optionnel pour le monitoring) =====
# SENTRY_DSN=

# ===== ANALYTICS (Optionnel) =====
# NEXT_PUBLIC_GA_ID=

# Limite de taille de fichier en bytes (par défaut: 10485760 = 10MB)
# MAX_FILE_SIZE=10485760

# Nombre maximal de caractères à analyser
# MAX_CONTENT_LENGTH=10000

# Timeout pour l'analyse en ms
# ANALYSIS_TIMEOUT=60000
